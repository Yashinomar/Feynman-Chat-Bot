# Prisma resolves relative file paths against prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# Generate a private value with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GEMINI_API_KEY=""
# Optional. Required to open registration during a student pilot.
REGISTRATION_CODE=""
# Optional: enable only behind a proxy that replaces x-forwarded-for.
TRUST_PROXY="false"
# Optional persistent directory for local speech model downloads.
TRANSFORMERS_CACHE=".cache/transformers"
